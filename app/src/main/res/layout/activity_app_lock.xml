<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mindease_purple"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingTop="54dp"
    android:paddingBottom="36dp">

    <!-- Top Icon / Logo -->
    <TextView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_dot_active"
        android:backgroundTint="#25FFFFFF"
        android:gravity="center"
        android:text="🔒"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="MindEase Lock"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvLockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Enter your 4-digit PIN"
        android:textColor="@color/mindease_lavender"
        android:textSize="14sp" />

    <!-- 4 PIN Dots -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_dot_inactive" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Keypad Grid (3x4) -->
    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <!-- Row 1: 1 2 3 -->
        <TableRow android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="2"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />
        </TableRow>

        <!-- Row 2: 4 5 6 -->
        <TableRow android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="4"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="6"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />
        </TableRow>

        <!-- Row 3: 7 8 9 -->
        <TableRow android:layout_marginBottom="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="7"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey8"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="8"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="9"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />
        </TableRow>

        <!-- Row 4: Cancel / 0 / Backspace -->
        <TableRow>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey0"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#25FFFFFF"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:cornerRadius="36dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="sans-serif-bold"
                android:text="⌫"
                android:textColor="@color/white"
                android:textSize="22sp"
                app:cornerRadius="36dp" />
        </TableRow>
    </TableLayout>

    <TextView
        android:id="@+id/btnForgotPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:padding="8dp"
        android:text="Forgot PIN?"
        android:textColor="@color/mindease_lavender"
        android:textSize="13sp" />

</LinearLayout>
